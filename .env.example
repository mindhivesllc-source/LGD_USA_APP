# Database
# Local dev: file:dev.sqlite
# Railway production: file:/app/db/dev.sqlite
DATABASE_URL=file:dev.sqlite

# Shopify App
SHOPIFY_API_KEY=your_shopify_client_id
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=write_products,read_products,read_locations,read_inventory,write_inventory
SHOPIFY_STORE=your-store.myshopify.com
# Optional: use the app handle if Shopify Admin does not accept the client ID in /apps/{id}.
SHOPIFY_APP_HANDLE=your-app-handle

# LGD Supplier API
SUPPLIER_API_BASE=https://lgdusallc.com/developer-api
SUPPLIER_API_KEY=your_api_key

# Sync Settings
SYNC_INTERVAL_HOURS=6

# Video (Basic plan compatible - opens in new tab)
VIDEO_OPEN_IN_NEW_TAB=true
